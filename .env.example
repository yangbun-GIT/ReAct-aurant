# OpenAI 또는 OpenAI 호환 LLM API를 사용할 때 설정합니다.
# 실제 API 키는 이 파일에 넣지 말고 로컬 전용 .env 파일에만 넣습니다.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# 과제에서 외부 맛집 검색 API를 선택적으로 사용할 때 설정합니다.
# 기본 구현은 API key 없이 로컬 샘플 데이터셋으로 동작해야 합니다.
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
