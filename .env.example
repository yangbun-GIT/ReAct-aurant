# OpenAI 또는 OpenAI 호환 LLM API를 사용할 때 설정합니다.
# 실제 API 키는 이 예시 파일에 넣지 말고 로컬 전용 .env 파일에만 넣습니다.
#
# OPENAI_API_KEY:
# - GPT Agent 모드에서 요청 분석 계획, Reflection, 최종 답변 생성을 수행할 때 사용합니다.
# - OpenAI 대시보드에서 발급받은 API key를 입력합니다.
# - OpenAI API key 형식의 문자열을 입력합니다.
# - 교수님이 수업용으로 제공한 GPT API 키도 여기에 입력하면 됩니다.
OPENAI_API_KEY=

# OPENAI_BASE_URL:
# - OpenAI 공식 API를 쓰면 기본값 https://api.openai.com/v1 을 사용합니다.
# - Ollama, LM Studio, vLLM, OpenRouter 등 OpenAI 호환 API를 쓰면 해당 서비스의 base URL을 입력합니다.
OPENAI_BASE_URL=https://api.openai.com/v1

# OPENAI_MODEL:
# - GPT Agent 모드에서 사용할 LLM 모델명을 입력합니다.
# - 예: gpt-4o-mini, gpt-4.1-mini, 또는 OpenAI 호환 서버에서 제공하는 모델명
OPENAI_MODEL=

# 과제에서 외부 맛집 검색 API를 선택적으로 사용할 때 설정합니다.
# 기본 구현은 API key 없이 로컬 샘플 데이터셋으로 동작해야 합니다.
# 비용이 들지 않도록 Kakao/Naver/Google Places는 기본 구현에서 사용하지 않습니다.
# 날씨 정보는 API key가 필요 없는 Open-Meteo 또는 mock 날씨를 사용합니다.
#
# KAKAO_REST_API_KEY:
# - Kakao Developers에서 애플리케이션을 만든 뒤 발급되는 REST API 키를 입력합니다.
# - Kakao Local API로 장소/주소 검색을 사용할 때 필요합니다.
# - 현재 프로젝트 기본 구현에서는 비워 둡니다.
KAKAO_REST_API_KEY=

# NAVER_CLIENT_ID:
# - Naver Developers에서 애플리케이션을 등록하면 발급되는 Client ID를 입력합니다.
# - Naver Search API로 지역/맛집 검색을 사용할 때 필요합니다.
# - 현재 프로젝트 기본 구현에서는 비워 둡니다.
NAVER_CLIENT_ID=

# NAVER_CLIENT_SECRET:
# - Naver Developers에서 Client ID와 함께 발급되는 Client Secret을 입력합니다.
# - Naver Search API 호출 시 NAVER_CLIENT_ID와 함께 사용합니다.
# - 현재 프로젝트 기본 구현에서는 비워 둡니다.
NAVER_CLIENT_SECRET=

# GOOGLE_PLACES_API_KEY:
# - Google Cloud Console에서 Places API를 활성화한 뒤 발급받은 API key를 입력합니다.
# - Google Places API로 장소 검색, 평점, 리뷰 기반 정보를 사용할 때 필요합니다.
# - billing 및 과금 리스크가 있으므로 현재 프로젝트에서는 사용하지 않습니다.
GOOGLE_PLACES_API_KEY=

# 한국관광공사 TourAPI / 공공데이터포털 국문 관광정보 서비스
# 기본 구현은 TOUR_API_SERVICE_KEY가 없으면 로컬 샘플 데이터셋으로 fallback합니다.
# 전주 음식점 조회 기준: contentTypeId=39, areaCode=37, sigunguCode=12
#
# TOUR_API_SERVICE_KEY:
# - 공공데이터포털 마이페이지 > 오픈API > 개발계정에서 확인합니다.
# - "한국관광공사_국문 관광정보 서비스_GW"의 일반 인증키(Decoding)를 입력합니다.
# - 실제 키는 이 파일이 아니라 로컬 전용 .env 파일에만 입력합니다.
TOUR_API_SERVICE_KEY=

# TOUR_API_BASE_URL:
# - 한국관광공사 국문 관광정보 서비스 GW의 KorService2 엔드포인트입니다.
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# TOUR_API_MOBILE_OS:
# - 공공데이터포털 필수 파라미터입니다.
# - 데스크톱/CLI 과제 실행은 ETC를 사용합니다.
TOUR_API_MOBILE_OS=ETC

# TOUR_API_MOBILE_APP:
# - 공공데이터포털 필수 파라미터입니다.
# - 임의 애플리케이션 식별자이며 과제명으로 둡니다.
TOUR_API_MOBILE_APP=ReAct-aurant

# TOUR_API_DEFAULT_AREA_CODE:
# - 전북 지역 코드입니다.
TOUR_API_DEFAULT_AREA_CODE=37

# TOUR_API_DEFAULT_SIGUNGU_CODE:
# - 전주시 시군구 코드입니다.
TOUR_API_DEFAULT_SIGUNGU_CODE=12
